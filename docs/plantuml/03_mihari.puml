@startuml
skinparam backgroundColor transparent
skinparam shadowing false
skinparam defaultFontName "Meiryo"
skinparam defaultFontSize 13
skinparam roundCorner 8
skinparam ArrowColor #666666
skinparam activity {
  BorderColor #999999
  BackgroundColor #FFFFFF
  DiamondBorderColor #999999
  DiamondBackgroundColor #FFF6E5
}

start
:使う人が何か発言する;
:UserPromptSubmit フックが watch.py を動かす;
:自分の生ログを開き
"compact_boundary" の行を数える;
if (圧縮は起きたか?) then (0回)
  :何も出さない;
  stop
else (1回以上)
  if (同じ回数で知らせ済みか?) then (はい)
    :何も出さない;
    stop
  else (いいえ)
    :一時フォルダーに回数を記録する;
    :会話に1行足す
    「区切りのよいところで /compact を打ち、
    新しいセッションで『◯◯を継いで』と言えば
    続きから始められます」;
    stop
  endif
endif
@enduml
