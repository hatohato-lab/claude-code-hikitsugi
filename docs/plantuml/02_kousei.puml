@startuml
skinparam backgroundColor transparent
skinparam shadowing false
skinparam defaultFontName "Meiryo"
skinparam defaultFontSize 13
skinparam roundCorner 8
skinparam ArrowColor #666666
skinparam rectangle {
  BorderColor #999999
  BackgroundColor #FFFFFF
}

rectangle "claude-code-hikitsugi（プラグイン）" as R #F7F7F5 {
  rectangle ".claude-plugin\\" as M #EAF3FB {
    rectangle "plugin.json\n名前・版・説明" as m1
    rectangle "marketplace.json\n配り元の目録。source は ./" as m2
  }
  rectangle "skills\\hikitsugi\\" as SK #FFF6E5 {
    rectangle "SKILL.md\n手順書。本体はこれ" as s1
    rectangle "scripts\\last_summary.py\n最後の要約を取り出す" as s2
  }
  rectangle "hooks\\" as H #E6F4EA {
    rectangle "hooks.json\n発言のたびに watch.py を動かす登録" as h1
    rectangle "watch.py\n圧縮が起きたら1回だけ知らせる" as h2
  }
  rectangle "eval\\" as E {
    rectangle "oracle.py\n機械判定" as e1
    rectangle "corpus\\ 作り物のログ2本" as e2
  }
}

note bottom of M
  この2つがあると、GitHub から
  /plugins で直接入れられる。
end note
@enduml
