@startuml
skinparam backgroundColor transparent
skinparam shadowing false
skinparam defaultFontName "Meiryo"
skinparam defaultFontSize 13
skinparam ArrowColor #666666
skinparam sequence {
  ParticipantBorderColor #999999
  ParticipantBackgroundColor #FFFFFF
  LifeLineBorderColor #CCCCCC
  ActorBorderColor #999999
  ActorBackgroundColor #FFFFFF
}

actor "使う人" as U
participant "古いセッション" as OLD
database "生ログ\n<ID>.jsonl" as LOG
participant "新しいセッション" as NEW
participant "last_summary.py" as S

== 区切りをつける ==
U -> OLD : /compact
OLD -> LOG : 要約を1行書く\n（9つの見出し・平均15,375字）

== 引き継ぐ ==
U -> NEW : 「◯◯を継いで」
NEW -> S : --session ◯◯
S -> LOG : "isCompactSummary":true の最後の行を探す
alt 要約がある
  S --> NEW : 要約の本文・時刻・ログのパス
  NEW --> U : 目標・決まったこと・残作業・止まっている場所・次の一手
else 要約がない
  S --> NEW : 「要約がありません」
  NEW --> U : 前のセッションで /compact を打ってください
end
@enduml
